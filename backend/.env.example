# Copier ce fichier en .env puis adapter les valeurs.
# Ne jamais committer le fichier .env réel.

# Serveur backend
PORT=4000
NODE_ENV=development
# En production derrière HTTPS : COOKIE_SECURE=true
COOKIE_SECURE=false
# Origine frontend autorisée (CORS)
CORS_ORIGIN=http://localhost:3000

# Base de données
# DB_CLIENT : sqlite (défaut, fichier local — recommandé pour un poste unique)
#             ou mysql (MariaDB, pour un déploiement multi-utilisateurs)
DB_CLIENT=sqlite
# Fichier SQLite (uniquement si DB_CLIENT=sqlite) ; créé avec ses migrations
DB_FILE=data/scolaire.db
# --- Paramètres MariaDB (uniquement si DB_CLIENT=mysql) ---
# Ne jamais exposer MariaDB sur Internet
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scolaire
DB_USER=scolaire_app
DB_PASSWORD=

# Limitation des tentatives de connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Session
SESSION_TTL_HOURS=12

# Fuseau horaire de l'établissement
TZ=Indian/Antananarivo

# ---------- Assistant IA pédagogique (étape 6) ----------
# Laisser AI_PROVIDER=none désactive l'IA : les autres modules fonctionnent
# normalement sans Internet et sans fournisseur.
# AI_PROVIDER : none | openai | anthropic | ollama
# AI_MODEL : nom du modèle (ex : gpt-4o-mini, claude-3-5-haiku-latest, llama3.1)
# AI_BASE_URL : surcharge facultative (proxy d'établissement ou Ollama local)
# AI_API_KEY : clé du fournisseur — UNIQUEMENT ici, jamais en base, jamais
#              dans les journaux, jamais envoyée au navigateur.
# AI_TIMEOUT_MS : délai maximal d'un appel IA (défaut 60000)
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=60000

# ---------- Orchestrateur multi-IA (module ai-orchestrator) ----------
# L'utilisateur ne choisit JAMAIS le fournisseur : le routeur prend le premier
# disponible. Un fournisseur sans clé est simplement filtré (aucune erreur).
# Les clés restent UNIQUEMENT ici (serveur), jamais dans le code, la base,
# les journaux ou le navigateur.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# QWEN_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Ollama local : aucune clé, gratuit, toujours en dernier recours.
# AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Budget IA distant par jour (USD, tous fournisseurs payants confondus)
# AI_DAILY_BUDGET_USD=2.00
# Quotas de messages par jour et par rôle
# AI_ROLE_DAILY_LIMIT_TEACHER=100
# AI_ROLE_DAILY_LIMIT_STUDENT=30

# ---------- IA locale Ollama (étape 19) ----------
# Configuration recommandée pour l'IA locale (aucune donnée ne sort du PC) :
#   AI_PROVIDER=ollama
#   AI_MODEL=llama3.1:8b        (modèle 8B quantifié ; adapter à la version d'Ollama)
#   AI_BASE_URL=http://127.0.0.1:11434
#   AI_TIMEOUT_MS=120000        (génération locale plus lente qu'un appel distant)
#
# Installation (à exécuter par l'administrateur, jamais automatique) :
#   1. Installer Ollama : https://ollama.com/download (Windows)
#   2. Télécharger le modèle : ollama pull llama3.1:8b
#   3. Ollama écoute par défaut sur 127.0.0.1:11434 — ne PAS l'exposer au
#      réseau local (ne pas définir OLLAMA_HOST=0.0.0.0) sans décision de
#      sécurité explicite.
# La présence du modèle est vérifiée avant chaque génération ; si Ollama est
# arrêté ou le modèle absent, l'application affiche un message clair et
# n'invente jamais une réussite.
